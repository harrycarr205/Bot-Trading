# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Trading mode ---
# Must be "paper" until an explicit, written decision to go live.
TRADING_MODE=paper

# --- Alpaca: paper and live keys are kept in clearly separate variables
# so a config mistake can't silently point paper logic at a live key. ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Database (Postgres + pgvector second brain) ---
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
# Dedicated database the test suite uses — kept separate from the dev
# database above so tests are never polluted by real scheduler-written data.
TEST_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading_test

# --- Ollama (LLM runtime for TradingAgents — local server required either way;
# a model name ending ":cloud" is proxied by the local server to Ollama Cloud
# using your signed-in account, everything else runs on this machine) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Deep-think: Research Manager, Trader, Risk Judge, Portfolio Manager.
# Quick-think: the four analysts. Change either independently to try a
# different/better model later — local model name or "<name>:cloud".
TRADINGAGENTS_DEEP_THINK_MODEL=qwen2.5:7b-instruct
TRADINGAGENTS_QUICK_THINK_MODEL=qwen2.5:7b-instruct
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_DISCUSS_ROUNDS=1
TRADINGAGENTS_RUN_MAX_ATTEMPTS=2
# Empty = use TradingAgents' own default location for trading_memory.md.
TRADINGAGENTS_MEMORY_LOG_PATH=

# --- Orchestration schedule (5-field cron, always interpreted in
# America/New_York regardless of host machine locale) ---
PRE_MARKET_CRON=35 9 * * mon-fri
MIDDAY_CRON=30 12 * * mon-fri

# --- Ticker selection (orchestration/ticker_selection.py) — held positions
# are always reassessed every cycle, uncapped, on top of this many
# "discovery" slots filled from config/candidate_universe.yaml via a
# momentum + relative-volume screen. Tune based on observed API usage. ---
DISCOVERY_SLOTS_PER_CYCLE=4

# --- Discord alerting ---
DISCORD_WEBHOOK_URL=

# --- Heartbeat watchdog (orchestration/watchdog.py — a second process,
# run alongside the scheduler, that alerts if it dies or hangs) ---
HEARTBEAT_GRACE_MINUTES=30
WATCHDOG_CHECK_INTERVAL_MINUTES=20

# --- Kill switch ---
# Independent of the main process: an external actor (you, or a monitor)
# creates this file to halt order placement immediately, even if the
# scheduler process is stuck. Checked by the risk validation layer on
# every single order, not by the agent itself.
KILL_SWITCH_FILE=/Users/harry/Documents/Bot-Trading/KILL_SWITCH

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Optional TradingAgents data vendors (NOT read via Settings above —
# read directly from the process environment by TradingAgents' own vendor
# code; scheduler.py loads this file into the real environment on startup
# specifically so these reach it). Both optional; free tiers available. ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
