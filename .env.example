# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Trading mode ---
# Must be "paper" until an explicit, written decision to go live.
TRADING_MODE=paper

# --- Alpaca: paper and live keys are kept in clearly separate variables
# so a config mistake can't silently point paper logic at a live key. ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Database (Postgres + pgvector second brain) ---
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading

# --- Ollama (local LLM runtime for TradingAgents) ---
OLLAMA_BASE_URL=http://localhost:11434
TRADINGAGENTS_MODEL=qwen2.5:7b-instruct

# --- Discord alerting ---
DISCORD_WEBHOOK_URL=

# --- Kill switch ---
# Independent of the main process: an external actor (you, or a monitor)
# creates this file to halt order placement immediately, even if the
# scheduler process is stuck. Checked by the risk validation layer on
# every single order, not by the agent itself.
KILL_SWITCH_FILE=/Users/harry/Documents/Bot-Trading/KILL_SWITCH

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
