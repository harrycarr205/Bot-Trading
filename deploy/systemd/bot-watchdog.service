[Unit]
Description=Bot-Trading watchdog (heartbeat monitor)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/Bot-Trading
ExecStart=/home/deploy/Bot-Trading/.venv/bin/python -m tradingsystem.orchestration.watchdog
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
